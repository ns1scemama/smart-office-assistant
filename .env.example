# .env.example — commit this file, never the real .env

N8N_BASE_URL=https://your-n8n-host/webhook
N8N_PROCESS_PATH=/process-document
N8N_DOCUMENTS_PATH=/documents
N8N_REVIEW_PATH=/review
N8N_SECRET=replace-me
REQUEST_TIMEOUT_MS=90000
MAX_FILE_MB=10

# Server port for the thin Express proxy
PORT=3001

# Frontend build-time flag: "true" uses src/api/mock.js, "false" calls the server
VITE_USE_MOCK=true
