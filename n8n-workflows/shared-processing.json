    {
      "id": "infoextract",
      "name": "Information Extractor",
      "type": "@n8n/n8n-nodes-langchain.informationExtractor",
      "typeVersion": 1,
      "position": [
        980,
        300
      ],
      "parameters": {
        "text": "={{ $json.text || $json.data }}",
        "schemaType": "fromJson",
        "jsonSchemaExample": "{\"document_type\": \"invoice\", \"sender_or_company\": \"Not found\", \"summary\": \"Short summary of the document in up to three sentences.\", \"requested_action\": \"No action found\", \"deadline\": \"Not found\", \"urgency\": \"Low\", \"department\": \"General\"}",
        "options": {
          "systemPromptTemplate": "Read the document like an office assistant. Extract only information that appears in the document. Do not invent missing details.\ndocument_type must be exactly one of: invoice, request, report, complaint, contract, quote, other.\nsender_or_company: name of the person or organization, or the exact text Not found if absent.\nsummary: up to three short sentences.\nrequested_action: what the company should do next, or the exact text No action found if absent.\ndeadline: exactly as written in the document, or the exact text Not found if absent.\nurgency must be exactly one of: Low, Medium, High. Use High only when there is an immediate deadline, payment risk, legal or safety risk, or an explicit urgent request.\ndepartment must be exactly one of: Sales, Finance, Support, HR, Management, General."
        }
      }
    },
