{
  "name": "Smart Office Assistant - Part 1 (Drive Trigger)",
  "nodes": [
    {
      "id": "trig1",
      "name": "New File in Incoming",
      "type": "n8n-nodes-base.googleDriveTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "triggerOn": "specificFolder",
        "folderToWatch": {
          "__rl": true,
          "mode": "id",
          "value": "1LdxGtYvjbxoO4SQJNOM4tc62_oOfvL9o"
        },
        "event": "fileCreated"
      }
    },
    {
      "id": "call1",
      "name": "ProcessDocument",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "WUhcBFBk96kP2NWU"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "fileId": "={{ $json.id }}",
            "fileName": "={{ $json.name }}",
            "mimeType": "={{ $json.mimeType }}"
          }
        },
        "options": {}
      }
    },
    {
      "id": "move1",
      "name": "MoveToProcessed",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        440,
        0
      ],
      "parameters": {
        "resource": "file",
        "operation": "move",
        "fileId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $('New File in Incoming').item.json.id }}"
        },
        "driveId": {
          "mode": "list",
          "value": "My Drive"
        },
        "folderId": {
          "__rl": true,
          "mode": "id",
          "value": "1LORFJgwyrPaFb_ztvPOUHolbep2cABEk"
        },
        "options": {}
      }
    }
  ],
  "connections": {
    "New File in Incoming": {
      "main": [
        [
          {
            "node": "ProcessDocument",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "ProcessDocument": {
      "main": [
        [
          {
            "node": "MoveToProcessed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {}
}